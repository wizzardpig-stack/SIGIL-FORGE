    const svg = document.createElementNS('http://www.w3.org/2000/svg','svg');
    svg.setAttribute('viewBox','0 0 560 560'); svg.setAttribute('class','preview-svg'); svg.setAttribute('id','wheelSvg');
    previewFrame.appendChild(svg);
    // reset global pointer to same id? easier use variable update
    wheelSvg = svg;
  }
  function renderFinal(triggerPop=false){
    renderWheel(-1,false,true);
    if(triggerPop) triggerCompletionPop();
    printSigil.innerHTML = finalSvgString(currentVariant,{transparent:true,forExport:true});
    printMeta.textContent = `${state.raw || ''}  •  ${state.reduced || ''}  •  ${state.nums?.join(' → ') || ''}`;
  }

  function triggerCompletionPop(){
    if(!previewFrame) return;
    previewFrame.classList.remove('completion-burst');
    void previewFrame.offsetWidth;
    previewFrame.classList.add('completion-burst');
    timers.push(setTimeout(()=>previewFrame.classList.remove('completion-burst'), 980));
  }

  function triggerFinalForgeSequence(){
    const screen = chamberScreen;
    const banner = document.querySelector('.stage-banner');
    if(screen){ screen.classList.remove('final-forging'); void screen.offsetWidth; screen.classList.add('final-forging'); }
    if(forgeStage){ forgeStage.classList.remove('final-charging'); void forgeStage.offsetWidth; forgeStage.classList.add('final-charging'); }
    if(banner){ banner.classList.remove('forged-glow'); void banner.offsetWidth; banner.classList.add('forged-glow'); }
    ['boxOriginal','boxVowels','boxDuplicates','boxPath'].forEach((id,i)=>{
      const el = $(id);
      if(!el) return;
      timers.push(setTimeout(()=>{
        el.classList.remove('ritual-pulse');
        void el.offsetWidth;
        el.classList.add('ritual-pulse');
      }, i * (isLeanDevice() ? 55 : 130)));
      timers.push(setTimeout(()=>el.classList.remove('ritual-pulse'), 780 + i * (isLeanDevice() ? 55 : 130)));
    });
    timers.push(setTimeout(()=>{
      if(screen) screen.classList.remove('final-forging');
      if(forgeStage) forgeStage.classList.remove('final-charging');
      if(banner) banner.classList.remove('forged-glow');
    }, isLeanDevice() ? 820 : 1450));
  }

  // V24: SIGIL SEALED completion moment. One-shot, timer-driven, fully cleared on replay/edit.
  function triggerSealMoment(){
    const nums = state.nums || [];
    if(!nums.length) return;
    const lean = isLeanDevice();
    const startDelay = lean ? 240 : 480;
    const step = lean ? 150 : 220;
    // Flash ONLY the numbers the sigil used, one at a time, in the exact order they were drawn.
    // The lit window is shorter than the step so flashes never overlap or stack.
    const litMs = step - 40;
    nums.forEach((n, i)=>{
      timers.push(setTimeout(()=>{
        if(setStageCurrent !== 'final' || !wheelSvg) return;
        wheelSvg.querySelectorAll('.node-circle.seal-flash').forEach(el=>el.classList.remove('seal-flash'));
        const node = wheelSvg.querySelectorAll('.node-circle')[n-1];
        if(!node) return;
        node.classList.add('seal-flash');
        timers.push(setTimeout(()=>node.classList.remove('seal-flash'), litMs));
      }, startDelay + i*step));
    });
    // Then one pulse + brief shimmer, and the status flips to SIGIL SEALED.
    const sealAt = startDelay + nums.length*step + 90;
    timers.push(setTimeout(()=>{
      if(setStageCurrent !== 'final') return;
      setStatus('SIGIL SEALED');
      if(!previewFrame) return;
      previewFrame.classList.remove('seal-pulse');
      void previewFrame.offsetWidth;
      previewFrame.classList.add('seal-pulse');
      const shimmer = document.createElement('div');
      shimmer.className = 'seal-shimmer-layer';
      shimmer.setAttribute('aria-hidden','true');
      previewFrame.appendChild(shimmer);
      timers.push(setTimeout(()=>{
        previewFrame.classList.remove('seal-pulse');
        if(shimmer.parentNode) shimmer.remove();
      }, lean ? 700 : 1000));
    }, sealAt));
  }

  function rerenderCurrentPreview(){
    renderPreviewMode();
    if(currentScreen==='chamber' && state.nums.length){
      if(setStageCurrent==='final') renderFinal();
      else if(setStageCurrent==='seal') renderWheel(-1,false,false,true);
      else renderWheel(-1,false,false);
    }
    const btn = $('transparentPreviewBtn');
    if(btn) btn.classList.toggle('active', transparentPreview);
  }

  function safeFileStem(){
    const raw = (state.raw || intentInput.value || 'sigil').trim().toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
    return raw.slice(0,42) || 'sigil';
  }

  function triggerDownloadBlob(blob, filename){
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(()=>URL.revokeObjectURL(url), 1200);
  }

  function exportSvg(){
    const svg = finalSvgString(currentVariant,{transparent:transparentPreview,forExport:true});
    triggerDownloadBlob(new Blob([svg],{type:'image/svg+xml;charset=utf-8'}), `${safeFileStem()}-${currentVariant}${transparentPreview?'-transparent':''}.svg`);
  }

  function exportPng(transparent=false){
    const svg = finalSvgString(currentVariant,{transparent,forExport:true});
    const blob = new Blob([svg], {type:'image/svg+xml;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = ()=>{
      const canvas = document.createElement('canvas');
      canvas.width = 1400; canvas.height = 1400;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0,0,canvas.width,canvas.height);
      ctx.drawImage(img,0,0,canvas.width,canvas.height);
      canvas.toBlob((pngBlob)=>{
        if(pngBlob) triggerDownloadBlob(pngBlob, `${safeFileStem()}-${currentVariant}${transparent?'-transparent':''}.png`);
        URL.revokeObjectURL(url);
      }, 'image/png');
    };
    img.onerror = ()=>URL.revokeObjectURL(url);
    img.src = url;
  }

  // V24: Export Pack — transparent PNG + black-background PNG + SVG + metadata TXT.
  // Downloads are staggered so browsers don't swallow the extra files.
  function exportSvgFile(transparent){
    const svg = finalSvgString(currentVariant,{transparent:!!transparent,forExport:true});
    triggerDownloadBlob(new Blob([svg],{type:'image/svg+xml;charset=utf-8'}), `${safeFileStem()}-${currentVariant}${transparent?'-transparent':''}.svg`);
  }
  function exportMetaTxt(){
    const lines = [
      'SIGIL STUDIO — EXPORT PACK',
      '==========================',
      'Intention: ' + (state.raw || '—'),
      'Final cleaned text: ' + (state.reduced || '—'),
      'Number path: ' + (state.nums && state.nums.length ? state.nums.join(' → ') : '—'),
      'Color: ' + sigilColorLabel + ' (' + sigilColor + ')',
      'Variant: ' + currentVariant,
      'Background mode: ' + stageBackground,
      'Exported: ' + new Date().toLocaleString()
    ];
    triggerDownloadBlob(new Blob([lines.join('\n')], {type:'text/plain;charset=utf-8'}), `${safeFileStem()}-sigil-meta.txt`);
  }
  function exportPack(){
    if(!state.nums.length) return;
    exportPng(true);                              // 1. transparent PNG
    setTimeout(()=>exportPng(false), 520);        // 2. PNG with black background
    setTimeout(()=>exportSvgFile(true), 1040);    // 3. SVG
