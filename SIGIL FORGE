  function forgeDurationMs(){
    const segCount = Math.max(1, state.nums.length - 1);
    const timing = ritualTiming();
    const totalTicks = Math.max(1, segCount * timing.ticksPerSeg);
    return timing.drawStart + totalTicks * timing.tickMs + timing.sealGap + timing.sealDuration + timing.finalPad;
  }
  function updateSummary(){
    summaryIntent.textContent = state.clean || sanitize(intentInput.value) || '—';
    summaryColor.textContent = sigilColorLabel;
  }
  function setVariant(name){
    currentVariant = name;
    document.querySelectorAll('[data-variant]').forEach(btn=>{ const on = btn.dataset.variant===name; btn.classList.toggle('active', on); btn.classList.toggle('secondary', !on); });
    if(previewFrame){
      ['rune','astral','relic','raw','eclipse'].forEach(v=>previewFrame.classList.remove('variant-'+v));
      previewFrame.classList.add('variant-' + currentVariant);
    }
    if(currentScreen==='chamber' && state.nums.length && setStageCurrent==='final') renderFinal();
  }
  function setPreviewMode(name){
    previewMode = name;
    document.querySelectorAll('[data-preview]').forEach(btn=>{ const on = btn.dataset.preview===name; btn.classList.toggle('active', on); btn.classList.toggle('secondary', !on); });
    rerenderCurrentPreview();
  }
  let setStageCurrent = 'input';
  function gotoStage(stage){
    setStageCurrent = stage;
    setProcessActive(stage);
    const map = {
      input:['Awaiting ignition','Phrase prepared'],
      vowels:['Vowels burning','Stripping the breath'],
      duplicates:['Duplicates sealing','Collapsing repeats'],
      mapping:['Mapping letters','Numbers awakening'],
      draw:['Laser drawing','Forging path'],
      seal:['Sealing sigil','Cooling the mark'],
      final:['Sigil forged','Final form complete']
    };
    setStageTitle(map[stage][0]);
    setStatus(map[stage][1]);
    helperLine.textContent = {
      input:'The intention is loaded and ready.',
      vowels:'Vowels dissolve away so the skeletal phrase remains.',
      duplicates:'Repeated letters collapse into the first occurrence.',
      mapping:'The surviving letters illuminate their 1–9 correspondences.',
      draw:'The wheel traces the living path in sequence.',
      seal:'The raw line cools, seals, and locks its charge.',
      final:'Choose the final style and export format.'
    }[stage];
  }
  function resetForgeVisual(){
    clearTimers();
    renderPreviewMode();
    renderOriginalAnimated();
    vowelText.textContent = '—';
    duplicateText.textContent = '—';
    pathText.textContent = '—';
    renderAlphabet(alphabetGrid, []);
    renderWheel(-1,false,false);
    gotoStage('input');
    forgeStage.classList.toggle('ritual', ritualModeToggle.checked);
    previewFrame.classList.remove('cooling');
    chamberScreen.classList.remove('final-forging');
    forgeStage.classList.remove('final-charging');
    const banner = document.querySelector('.stage-banner'); if(banner) banner.classList.remove('forged-glow');
    ['boxOriginal','boxVowels','boxDuplicates','boxPath'].forEach(id=>{ const el=$(id); if(el) el.classList.remove('ritual-pulse'); });
  }
  function runRitual(){
    clearTimers();
    state = compute();
    updateSummary();
    setScreen('chamber');
    resetForgeVisual();
    renderOriginalAnimated();
    originalText.textContent = state.clean || '—';
    pathText.textContent = '—';

    const timing = ritualTiming();
    timers.push(setTimeout(()=>{ gotoStage('input'); originalText.textContent = state.clean || '—'; }, timing.input));
    timers.push(setTimeout(()=>{ gotoStage('vowels'); renderVowelAnimated(true); }, timing.vowels));
    timers.push(setTimeout(()=>{ gotoStage('duplicates'); renderDuplicateAnimated(true); }, timing.duplicates));
    timers.push(setTimeout(()=>{ gotoStage('mapping'); renderAlphabet(alphabetGrid, state.letters); pathText.textContent = pathDescription(); }, timing.mapping));

    const drawStart = timing.drawStart;
    const segCount = Math.max(1, state.nums.length - 1);
    const ticksPerSeg = timing.ticksPerSeg;
    const tickMs = timing.tickMs;
    const totalTicks = Math.max(1, segCount * ticksPerSeg);

    timers.push(setTimeout(()=>{ 
      gotoStage('draw'); 
      renderWheel(-1,true,false,false,0); 
    }, drawStart));

    for(let t=0; t<=totalTicks; t++){
      const progress = segCount * (t / totalTicks);
      timers.push(setTimeout(()=>{ 
        renderWheel(-1,true,false,false,progress);
      }, drawStart + t*tickMs));
    }

    const sealStart = drawStart + totalTicks*tickMs + timing.sealGap;
    const finalStart = sealStart + timing.sealDuration;
    timers.push(setTimeout(()=>{ 
      gotoStage('seal'); 
      previewFrame.classList.add('cooling'); 
      renderWheel(-1,false,false,true); 
    }, sealStart));
    timers.push(setTimeout(()=>{ 
      previewFrame.classList.remove('cooling'); 
      gotoStage('final'); 
      renderFinal(true); 
      triggerFinalForgeSequence(); 
      triggerSealMoment();
    }, finalStart));
  }

  function initSwatches(){
