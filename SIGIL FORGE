<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sigil Studio — Ritual Chamber V22</title>
  <style>
    :root{
      --bg:#040000;
      --bg2:#120202;
      --panel:#0d0101;
      --panel2:#170303;
      --line:#351010;
      --red:#d10a0a;
      --red2:#7a0000;
      --wine:#2a0505;
      --gold:#ff4fd8;
      --bone:#e8ddd0;
      --muted:#a89486;
      --shadow:rgba(209,10,10,.35);
      --sigil:#d10a0a;
      --purple:#ff5adf;
      --silver:#b8bcc8;
      --success:#e85dff;
      --stageGlow:rgba(209,10,10,.15);
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      overflow:hidden;
      background:
        radial-gradient(circle at 20% 10%, rgba(122,0,0,.26), transparent 28%),
        radial-gradient(circle at 80% 0%, rgba(255,107,223,.055), transparent 18%),
        radial-gradient(circle at 50% 120%, rgba(209,10,10,.14), transparent 42%),
        linear-gradient(135deg,#020000,#090101 45%,#140303);
      color:var(--bone);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    }
    body:before{
      content:"";
      position:fixed; inset:0;
      pointer-events:none;
      background:
        repeating-radial-gradient(circle at 50% 50%, rgba(255,255,255,.023) 0 1px, transparent 1px 7px),
        linear-gradient(90deg, transparent, rgba(209,10,10,.028), transparent);
      opacity:.6;
      mix-blend-mode:screen;
      z-index:0;
    }
    .app{
      position:relative; z-index:1;
      height:100%;
      padding:14px;
      display:flex; flex-direction:column; gap:12px;
    }
    .topbar{
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      min-height:64px;
      padding:10px 14px;
      border:1px solid rgba(209,10,10,.20);
      border-radius:22px;
      background:linear-gradient(180deg, rgba(16,2,2,.94), rgba(6,0,0,.88));
      box-shadow:0 16px 45px rgba(0,0,0,.36), inset 0 0 0 1px rgba(255,255,255,.02);
      flex:0 0 auto;
    }
    .brand{display:flex;align-items:center;gap:12px;min-width:0}
    .mark{width:42px;height:42px;border-radius:999px;border:1px solid rgba(209,10,10,.5);display:grid;place-items:center;background:radial-gradient(circle, rgba(209,10,10,.22), rgba(5,0,0,.8) 60%);box-shadow:0 0 24px rgba(209,10,10,.2), inset 0 0 18px rgba(209,10,10,.18)}
    .mark svg{width:28px;height:28px;filter:drop-shadow(0 0 10px var(--shadow))}
    h1,h2,h3{font-family:Georgia, 'Times New Roman', serif; margin:0; letter-spacing:.04em}
    h1{font-size:clamp(24px,3.2vw,40px); text-transform:uppercase; line-height:.95}
    .subtitle{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.14em; margin-top:4px}
    .top-actions,.row{display:flex; gap:8px; align-items:center; flex-wrap:wrap}
    button{
      appearance:none; border:none; cursor:pointer; color:var(--bone);
      background:linear-gradient(180deg, rgba(122,0,0,.95), rgba(42,5,5,.95));
      border:1px solid rgba(209,10,10,.45);
      border-radius:14px;
      padding:11px 14px;
      font-weight:800; letter-spacing:.07em; text-transform:uppercase; font-size:11px;
      box-shadow:0 0 0 1px rgba(255,255,255,.035) inset, 0 13px 30px rgba(0,0,0,.35);
      transition:.18s ease;
    }
    button:hover{transform:translateY(-1px); box-shadow:0 0 22px rgba(209,10,10,.18), 0 0 0 1px rgba(255,255,255,.05) inset}
    button.secondary{background:rgba(7,0,0,.75); border-color:rgba(255,79,216,.35); color:#d9cbbd}
    button.ghost{background:transparent; border-color:rgba(232,221,208,.12); color:var(--muted); box-shadow:none}
    button.small{padding:9px 11px; border-radius:11px; font-size:10px}
    button.active{background:linear-gradient(180deg, rgba(209,10,10,.9), rgba(122,0,0,.9)); color:#fff; border-color:rgba(255,180,180,.5)}
    button.primary{font-size:12px; padding:14px 18px}
    .shell{flex:1 1 auto; min-height:0; position:relative}
    .screen{position:absolute; inset:0; display:none; min-height:0}
    .screen.active{display:grid}

    .card{
      border:1px solid rgba(209,10,10,.22);
      background:linear-gradient(180deg, rgba(18,2,2,.92), rgba(5,0,0,.84));
      border-radius:24px;
      padding:16px;
      box-shadow: 0 20px 70px rgba(0,0,0,.42), inset 0 0 0 1px rgba(255,255,255,.02);
      position:relative;
      overflow:hidden;
      min-height:0;
    }
    .card:after{content:"";position:absolute;inset:auto -20% -40% -20%;height:160px;background:radial-gradient(ellipse, rgba(209,10,10,.10), transparent 70%);pointer-events:none}
    .eyebrow{font-size:10px; letter-spacing:.16em; color:var(--gold); text-transform:uppercase; margin-bottom:8px}
    .section-title{font-size:18px; text-transform:uppercase; letter-spacing:.08em; margin:0 0 10px; color:#fff4ea}
    .copy{color:var(--muted); line-height:1.5; font-size:13px}
    label{display:block; color:#d8c7b8; font-size:11px; text-transform:uppercase; letter-spacing:.12em; margin:14px 0 8px}
    textarea,input[type="text"]{
      width:100%; border-radius:18px; border:1px solid rgba(209,10,10,.28);
      background:rgba(0,0,0,.34); color:#fff5eb;
      padding:12px 14px; font-size:17px; outline:none; resize:none; min-height:82px;
      box-shadow: inset 0 0 24px rgba(0,0,0,.35);
    }
    textarea:focus,input[type="text"]:focus{border-color:rgba(209,10,10,.8); box-shadow:0 0 0 4px rgba(209,10,10,.12), inset 0 0 24px rgba(0,0,0,.35)}
    .toggle{display:flex; align-items:center; gap:8px; color:var(--muted); font-size:13px; text-transform:none; letter-spacing:0}
    .toggle input{accent-color:#d10a0a}

    .input-screen{grid-template-columns:minmax(260px,320px) minmax(0,1.45fr); gap:12px}
    .input-panel{display:flex; flex-direction:column; gap:8px}
    .input-footer{margin-top:8px; display:flex; gap:10px; flex-wrap:wrap; position:sticky; bottom:0; padding-top:10px; background:linear-gradient(180deg, rgba(11,1,1,0), rgba(11,1,1,.92) 28%)}
    .swatches{display:flex; gap:8px; flex-wrap:wrap; align-items:center}
    .swatch{width:28px;height:28px;border-radius:999px;border:1px solid rgba(255,255,255,.22);cursor:pointer;box-shadow:0 0 0 2px rgba(0,0,0,.35)}
    .swatch.active{outline:2px solid rgba(232,221,208,.75); outline-offset:2px}
    input[type="color"]{width:44px;height:34px;border:none;background:transparent;cursor:pointer}
    .mini-grid{display:grid;grid-template-columns:repeat(9,minmax(24px,1fr));gap:4px}
    .cell{min-height:28px;display:grid;place-items:center;border-radius:9px;border:1px solid rgba(232,221,208,.10);background:rgba(255,255,255,.025);color:#d8cbbb;font-weight:700;font-size:12px}
    .cell.num{color:var(--gold); background:rgba(255,79,216,.07)}
    .cell.hit{color:#fff;border-color:rgba(209,10,10,.9);background:rgba(209,10,10,.22);box-shadow:0 0 20px rgba(209,10,10,.28)}
    .cell.blank{opacity:.18}

    .preview-shell{display:grid; grid-template-rows:auto 1fr; gap:10px; min-height:0}
    .dormant-copy{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap}
    .compact-chart{display:grid;grid-template-columns:1fr;gap:8px}
    .chamber-box{display:grid;place-items:center;min-height:460px; height:100%; border:1px solid rgba(255,79,216,.18); border-radius:22px; background:radial-gradient(circle, rgba(122,0,0,.08), transparent 55%), rgba(0,0,0,.22); position:relative; overflow:hidden; padding:8px}
    .chamber-box:before{content:""; position:absolute; inset:12px; border:1px solid rgba(232,221,208,.05); border-radius:18px; pointer-events:none}
    svg{max-width:100%}
    .wheel-svg{width:min(760px,100%); max-width:100%; max-height:100%; height:auto; filter:drop-shadow(0 0 18px rgba(209,10,10,.18))}
    .ring{fill:rgba(0,0,0,.18); stroke:rgba(255,79,216,.34); stroke-width:2}
    .node-circle{fill:#090000; stroke:rgba(255,79,216,.54); stroke-width:2; transition:.2s ease}
    .node-circle.active-node{fill:rgba(209,10,10,.45); stroke:#ff5b4b; filter:drop-shadow(0 0 10px rgba(209,10,10,.9))}
    .node-text{fill:#e8ddd0; font-weight:900; font-size:18px; text-anchor:middle; dominant-baseline:middle; pointer-events:none}
    .guide-line{stroke:rgba(232,221,208,.08); stroke-width:1}
    .sigil-path{fill:none; stroke:var(--sigil); stroke-width:6; stroke-linecap:round; stroke-linejoin:round; filter:drop-shadow(0 0 7px var(--sigil));}

    .chamber-screen{grid-template-rows:auto 1fr auto; gap:10px}
    .summary-bar{display:flex; gap:10px; align-items:center; justify-content:space-between; flex-wrap:wrap; padding:12px 14px}
    .summary-text{font-size:12px; color:#fff4ea; letter-spacing:.05em}
    .summary-text .muted{color:var(--muted)}
    .stage-pills{display:flex; gap:7px; flex-wrap:wrap}
    .pill{padding:8px 10px; border-radius:999px; border:1px solid rgba(232,221,208,.10); color:var(--muted); font-size:10px; letter-spacing:.1em; text-transform:uppercase; background:rgba(0,0,0,.28)}
    .pill.active{color:#fff; border-color:rgba(209,10,10,.6); background:rgba(122,0,0,.28); box-shadow:0 0 18px rgba(209,10,10,.12)}
    .chamber-layout{display:grid; grid-template-columns:minmax(280px,1fr) minmax(380px,1.4fr) minmax(260px,.9fr); gap:10px; min-height:0}
    .process-panel,.side-panel,.main-panel{display:flex;flex-direction:column;min-height:0}
    .process-panel .process-stack{display:grid; gap:9px; overflow:hidden}
    .process-box{border:1px solid rgba(232,221,208,.09); border-radius:16px; padding:11px 12px; background:rgba(0,0,0,.22); min-height:68px}
    .process-box.active{border-color:rgba(209,10,10,.42); box-shadow:0 0 24px rgba(209,10,10,.08); background:linear-gradient(180deg, rgba(43,7,7,.55), rgba(0,0,0,.24))}
    .process-label{font-size:10px; color:var(--gold); text-transform:uppercase; letter-spacing:.15em; margin-bottom:6px}
    .process-value{font-size:18px; letter-spacing:.07em; color:#fff; word-break:break-word}
    .process-value.small{font-size:14px; color:#efe3d6; line-height:1.45}
    .main-panel .hero{display:grid; grid-template-rows:auto 1fr auto; min-height:0; gap:10px}
    .stage-banner{padding:10px 14px; border-radius:18px; border:1px solid rgba(255,79,216,.18); background:rgba(0,0,0,.23); display:flex; align-items:center; justify-content:space-between; gap:8px}
    .stage-title{font-size:16px; text-transform:uppercase; letter-spacing:.08em; font-family:Georgia, 'Times New Roman', serif}
    .status{font-size:11px; color:var(--gold); letter-spacing:.15em; text-transform:uppercase}
    .forge-stage{display:grid; place-items:center; min-height:0; border-radius:22px; border:1px solid rgba(209,10,10,.14); background:radial-gradient(circle, var(--stageGlow), transparent 55%), rgba(0,0,0,.18); position:relative; overflow:hidden}
    .forge-stage.ritual{background:radial-gradient(circle, rgba(255,107,223,.11), transparent 30%), radial-gradient(circle, rgba(209,10,10,.16), transparent 65%), rgba(0,0,0,.18)}
    .helper-line{font-size:12px; color:var(--muted); letter-spacing:.12em; text-transform:uppercase; text-align:center; margin-top:6px}
    .side-card{border:1px solid rgba(255,79,216,.18); border-radius:18px; padding:12px; background:rgba(0,0,0,.2)}
    .side-card + .side-card{margin-top:10px}
    .preview-modes,.variant-buttons{display:flex; gap:7px; flex-wrap:wrap}
    .variant-buttons{justify-content:flex-start}
    .bottom-dock{display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; padding:12px 14px}
    .bottom-left,.bottom-right{display:flex; gap:8px; align-items:center; flex-wrap:wrap}
    .preview-stage{display:grid; place-items:center; height:100%; width:100%; position:relative; padding:18px}
    .preview-frame{display:grid; place-items:center; width:min(100%,720px); height:min(100%,520px); border-radius:24px; position:relative}
    .preview-frame.mode-sigil{background:radial-gradient(circle, rgba(122,0,0,.12), transparent 58%), rgba(0,0,0,.18); border:1px solid rgba(209,10,10,.16)}
    .preview-frame.mode-phone{width:min(320px,76%); height:min(560px,92%); background:#0c0202; border:10px solid #1a0a0a; border-radius:38px; box-shadow:0 0 0 1px rgba(255,255,255,.03) inset}
    .preview-frame.mode-phone:before{content:""; position:absolute; top:10px; width:90px; height:16px; border-radius:0 0 16px 16px; background:#000}
    .preview-frame.mode-desktop{width:min(620px,94%); height:min(380px,88%); background:#090202; border:12px solid #171717; border-bottom-width:18px; border-radius:18px; box-shadow:0 12px 28px rgba(0,0,0,.4)}
    .preview-frame.mode-desktop:after{content:""; position:absolute; bottom:-36px; width:120px; height:26px; background:#272727; border-radius:0 0 14px 14px; box-shadow:0 20px 0 8px #1b1b1b}
    .preview-frame.mode-shirt{width:min(420px,88%); height:min(460px,90%); background:transparent}
    .shirt-shape{position:absolute; inset:0; clip-path:polygon(29% 8%, 41% 8%, 47% 4%, 53% 4%, 59% 8%, 71% 8%, 84% 18%, 76% 31%, 72% 92%, 28% 92%, 24% 31%, 16% 18%); background:#0e0e0e; border:1px solid rgba(255,255,255,.04)}
    .preview-frame.mode-poster{width:min(360px,84%); height:min(480px,92%); background:linear-gradient(180deg,#f0e0c3,#d8c2a2); border-radius:10px; box-shadow:0 18px 28px rgba(0,0,0,.32); color:#1d1206}
    .preview-frame.mode-poster .poster-head{position:absolute; top:18px; font-family:Georgia, serif; font-size:20px; letter-spacing:.08em; text-transform:uppercase; color:#34180a}
    .preview-svg{width:100%; height:100%}
    .transparent-note{font-size:11px; color:var(--muted)}

    .overlay{position:absolute; inset:0; background:rgba(0,0,0,.72); backdrop-filter:blur(6px); display:none; align-items:center; justify-content:center; padding:16px; z-index:8}
    .overlay.active{display:flex}
    .modal{width:min(1100px,100%); height:min(88vh,760px); display:grid; grid-template-rows:auto 1fr; gap:10px}
    .modal-head{display:flex; justify-content:space-between; gap:10px; align-items:center; padding:12px 14px}
    .gallery-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:12px; overflow:auto; padding-right:4px}
    .gallery-card{border:1px solid rgba(232,221,208,.11); background:rgba(0,0,0,.24); border-radius:18px; padding:10px; min-height:190px; cursor:pointer}
    .gallery-card svg{height:105px; width:100%; display:block; border-radius:12px; background:rgba(0,0,0,.22)}
    .gallery-title{font-size:11px; color:#fff; letter-spacing:.04em; margin-top:8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
    .gallery-meta{font-size:10px; color:var(--muted); margin-top:3px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
    .hidden{display:none!important}
    .notice{border:1px solid rgba(255,79,216,.24); background:rgba(255,79,216,.06); color:#d7c5a4; border-radius:16px; padding:11px 12px; font-size:12px; line-height:1.5}
    .print-card{display:none}
    .letter{display:inline-block; transition:.45s ease; margin-right:2px}
    .letter.vanish{color:#ff4545; transform:translateY(-10px) scale(.75); opacity:0; filter:blur(4px)}
    .letter.duplicate{color:#ff3636; transform:scale(.35); opacity:0; filter:blur(2px)}
    .cooling{animation:coolPulse .95s ease 1}
    @keyframes coolPulse{0%{transform:scale(.96);filter:brightness(1.6)}65%{transform:scale(1.02);filter:brightness(1.15)}100%{transform:scale(1);filter:brightness(1)}}

    @media (max-width: 1100px){
      .input-screen{grid-template-columns:1fr}
      .chamber-layout{grid-template-columns:250px 1fr}
      .side-panel{display:none}
    }
    @media (max-width: 860px){
      .app{padding:10px; gap:10px}
      .topbar{padding:10px 12px}
      .chamber-screen{grid-template-rows:auto 1fr auto}
      .chamber-layout{grid-template-columns:1fr}
      .process-panel{order:2}
      .main-panel{order:1}
      .process-panel .process-stack{grid-template-columns:repeat(2,minmax(0,1fr))}
      .summary-bar,.bottom-dock{padding:10px 12px}
      h1{font-size:26px}
    }
    @media (max-width: 620px){
      body{overflow:auto}
      .chamber-box{min-height:320px}
      .input-footer{position:static; background:none; padding-top:6px}
      .topbar{min-height:auto}
      .process-panel .process-stack{grid-template-columns:1fr}
      button{padding:10px 12px}
      .top-actions{display:none}
      .summary-bar{align-items:flex-start}
      .preview-frame.mode-phone{width:78%; height:88%}
      .bottom-dock{justify-content:flex-start}
    }
    @media print{
      body{background:white;color:black;overflow:visible}
      body:before,.app{display:none!important}
      .print-card{display:flex!important; min-height:100vh; align-items:center; justify-content:center; padding:30px; color:#111; background:white; font-family:Georgia,'Times New Roman',serif}
      .print-inner{text-align:center; width:100%}
      .print-title{font-size:28px; margin-bottom:20px; text-transform:uppercase; letter-spacing:.08em}
      .print-sigil svg{width:70vw; max-width:650px; height:auto}
      .print-meta{font-size:14px; margin-top:20px; color:#333; font-family:Arial,sans-serif}
    }
  
/* === V4 LAYOUT STABILITY PATCH: no clipped wheel + scrollable controls === */
html, body{
  height:100%;
}
body{
  overflow:hidden;
}
.app{
  padding:8px 10px;
  gap:8px;
}
.topbar{
  min-height:50px;
  padding:7px 10px;
  border-radius:18px;
}
.mark{
  width:36px;
  height:36px;
}
.mark svg{
  width:24px;
  height:24px;
}
h1{
  font-size:clamp(22px,2.8vw,34px);
}
.subtitle{
  font-size:10px;
  margin-top:2px;
}
.card{
  padding:12px;
  border-radius:20px;
}
.summary-bar{
  padding:7px 10px;
  min-height:44px;
}
.summary-text{
  font-size:11px;
}
.chamber-screen{
  grid-template-rows:auto minmax(0,1fr) auto;
  gap:7px;
}
.chamber-layout{
  grid-template-columns:minmax(200px,.7fr) minmax(500px,1.95fr) minmax(250px,.82fr);
  gap:8px;
  min-height:0;
  overflow:hidden;
}
.process-panel,
.main-panel,
.side-panel{
  min-height:0;
}
.side-panel.card{
  overflow-y:auto;
  overflow-x:hidden;
  padding-right:10px;
  scrollbar-width:thin;
}
.side-panel.card::-webkit-scrollbar{
  width:8px;
}
.side-panel.card::-webkit-scrollbar-thumb{
  background:rgba(255,79,216,.35);
  border-radius:99px;
}
.side-panel.card::-webkit-scrollbar-track{
  background:rgba(0,0,0,.18);
}
.main-panel .hero{
  grid-template-rows:auto minmax(0,1fr) auto;
  min-height:0;
}
.stage-banner{
  padding:7px 10px;
  border-radius:14px;
}
.stage-title{
  font-size:14px;
}
.status{
  font-size:10px;
}
.forge-stage{
  min-height:0;
  height:100%;
  overflow:hidden;
  padding:6px;
}
.preview-stage{
  width:100%;
  height:100%;
  min-height:0;
  display:grid;
  place-items:center;
  padding:10px;
  overflow:hidden;
}
.preview-frame{
  width:100%;
  height:100%;
  max-width:100%;
  max-height:100%;
  border-radius:18px;
  overflow:hidden;
}
.preview-frame.mode-sigil{
  aspect-ratio:1 / 1;
  width:min(100%, 66vh, 680px);
  height:auto;
  max-height:100%;
}
.preview-svg,
.wheel-svg{
  display:block;
  width:100%;
  height:100%;
  max-width:100%;
  max-height:100%;
  object-fit:contain;
}
.preview-frame.mode-sigil .preview-svg,
.preview-frame.mode-sigil .wheel-svg{
  width:100%;
  height:100%;
}
.bottom-dock{
  padding:7px 10px;
  min-height:42px;
  gap:6px;
}
.bottom-dock button{
  padding:7px 9px;
  font-size:9px;
}
.side-card{
  padding:10px;
  border-radius:14px;
}
.side-card + .side-card{
  margin-top:8px;
}
.preview-modes,
.variant-buttons{
  gap:6px;
}
.process-box{
  min-height:58px;
  padding:9px 10px;
}
.process-value{
  font-size:15px;
}
.process-value.small{
  font-size:12px;
}
.pill{
  padding:6px 8px;
  font-size:9px;
}
.helper-line{
  font-size:10px;
  margin-top:3px;
}
.input-screen{
  grid-template-columns:minmax(250px,310px) minmax(0,1.65fr);
}
textarea,input[type="text"]{
  min-height:70px;
  padding:10px 12px;
}
.chamber-box{
  min-height:0;
}
.chamber-box .wheel-svg{
  width:min(100%, 70vh, 720px);
  height:auto;
}
@media (max-width: 1250px){
  body{
    overflow:auto;
  }
  .app{
    height:auto;
    min-height:100vh;
  }
  .shell{
    min-height:calc(100vh - 74px);
  }
  .screen{
    position:relative;
    inset:auto;
  }
