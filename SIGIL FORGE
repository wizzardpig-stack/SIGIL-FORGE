  function lightenHex(hex, amount){
    return mixHex(hex, '#ffffff', amount);
  }
  function darkenHex(hex, amount){
    return mixHex(hex, '#000000', amount);
  }
  function setSigilToneVars(base){
    const root = document.documentElement.style;
    const prism = lightenHex(base, .22);
    const violet = lightenHex(base, .38);
    const inner = lightenHex(base, .58);
    const hot = lightenHex(base, .82);
    const spark = lightenHex(base, .72);
    root.setProperty('--sigil', base);
    root.setProperty('--sigil-prism', prism);
    root.setProperty('--sigil-violet', violet);
    root.setProperty('--sigil-inner', inner);
    root.setProperty('--sigil-hot', hot);
    root.setProperty('--sigil-spark', spark);
  }

  function buildPartialPath(nums, progress){
    const pts = nums.map(pointForNumber);
    if(!pts.length) return {d:'', activeIndex:-1, completedIndex:-1};
    if(pts.length===1){
      return {d:`M ${pts[0].x.toFixed(2)} ${pts[0].y.toFixed(2)}`, activeIndex:0, completedIndex:0};
    }
    const segCount = pts.length - 1;
    const clamped = Math.max(0, Math.min(progress, segCount));
    const fullSegs = Math.floor(clamped);
    const frac = clamped - fullSegs;
    let d = `M ${pts[0].x.toFixed(2)} ${pts[0].y.toFixed(2)} `;
    for(let i=1;i<=fullSegs;i++){
      d += `L ${pts[i].x.toFixed(2)} ${pts[i].y.toFixed(2)} `;
    }
    if(fullSegs < segCount){
      const partial = interpolatePoint(pts[fullSegs], pts[fullSegs+1], frac);
      d += `L ${partial.x.toFixed(2)} ${partial.y.toFixed(2)} `;
    }
    const activeIndex = Math.min(pts.length - 1, Math.max(0, Math.ceil(clamped)));
    return {d, activeIndex, completedIndex:Math.max(0, fullSegs)};
  }

  function arcanePalette(){
    return {
      primary: sigilColor,
      purple: lightenHex(sigilColor, .30),
      gold: lightenHex(sigilColor, .18),
      bone: '#e8ddd0',
      inner: lightenHex(sigilColor, .58),
      hot: lightenHex(sigilColor, .82),
      spark: lightenHex(sigilColor, .72)
    };
  }

  function sigilPremiumDefs(){
    const lean = isLeanDevice();
    const wideBlur = lean ? '5.2' : '9.5';
    const softBlur = lean ? '2.2' : '3.4';
    return `<filter id="sigilPremiumGlow" x="-80%" y="-80%" width="260%" height="260%">
      <feGaussianBlur in="SourceGraphic" stdDeviation="${softBlur}" result="softGlow"/>
      <feGaussianBlur in="SourceGraphic" stdDeviation="${wideBlur}" result="wideGlow"/>
      <feComponentTransfer in="wideGlow" result="wideBoost">
        <feFuncA type="linear" slope=".92"/>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode in="wideBoost"/>
        <feMergeNode in="softGlow"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>`;
  }

  function holoStroke(d, color, width=7, cap='stroke-linecap="round" stroke-linejoin="round"', opacity=1){
    const lean = isLeanDevice();
    const wide = Math.max(width * (lean ? 2.05 : 2.75), width + (lean ? 6 : 9)).toFixed(2);
    const mid = Math.max(width * 1.46, width + 3).toFixed(2);
    const core = width.toFixed(2);
    const inner = Math.max(1.6, width * .34).toFixed(2);
    const hot = Math.max(1.05, width * .15).toFixed(2);
    const echo = Math.max(width * 1.92, width + 5).toFixed(2);
    const prismColor = lightenHex(color, .22);
    const violetColor = lightenHex(color, .38);
    const sparkColor = lightenHex(color, .72);
    const innerColor = lightenHex(color, .58);
    const prism = lean ? '' : `<path class="sigil-holo-edge sigil-holo-prism" d="${d}" stroke="${prismColor}" stroke-width="${echo}" ${cap} opacity="${(.18*opacity).toFixed(2)}"/>`+
      `<path class="sigil-holo-edge sigil-holo-violet" d="${d}" stroke="${violetColor}" stroke-width="${(width*1.18).toFixed(2)}" ${cap} opacity="${(.24*opacity).toFixed(2)}"/>`+
      `<path class="sigil-holo-spark" d="${d}" stroke="${sparkColor}" stroke-width="${Math.max(.95, width*.12).toFixed(2)}" ${cap} opacity="${(.42*opacity).toFixed(2)}" stroke-dasharray="1 18"/>`;
    return `<path class="sigil-holo-wide" d="${d}" stroke="${color}" stroke-width="${wide}" ${cap} opacity="${(.13*opacity).toFixed(2)}"/>`+
           prism+
           `<path class="sigil-holo-mid" d="${d}" stroke="${color}" stroke-width="${mid}" ${cap} opacity="${(.58*opacity).toFixed(2)}"/>`+
           `<path class="sigil-holo-core" d="${d}" stroke="${color}" stroke-width="${core}" ${cap} opacity="${(.96*opacity).toFixed(2)}" filter="url(#sigilPremiumGlow)"/>`+
           `<path class="sigil-holo-inner" d="${d}" stroke="${innerColor}" stroke-width="${inner}" ${cap} opacity="${(.36*opacity).toFixed(2)}"/>`+
           `<path class="sigil-holo-hot" d="${d}" stroke="${lightenHex(color, .82)}" stroke-width="${hot}" ${cap} opacity="${(.56*opacity).toFixed(2)}"/>`;
  }

  function buildSigilMarkup(variant=currentVariant){
    const nums = state.nums || [];
    const pts = nums.map(pointForNumber);
    const rawPath = buildPath(nums);
    const smoothPath = buildSmoothPath(nums);
    if(!rawPath) return '';

    const cap = 'stroke-linecap="round" stroke-linejoin="round"';
    const {primary, purple, gold, bone, inner, hot, spark} = arcanePalette();
    const start = pts[0];
    const end = pts[pts.length-1];
    const mid = pts[Math.floor(pts.length/2)] || {x:280, y:280};
    const firstBend = pts[1] || mid;
    const lastBend = pts[Math.max(0, pts.length-2)] || mid;

    const halo = `<circle cx="280" cy="280" r="188" fill="none" stroke="${gold}" stroke-width="2.3" opacity=".38"/>`+
                 `<circle cx="280" cy="280" r="114" fill="none" stroke="${purple}" stroke-width="2.1" opacity=".30"/>`;

    let tickMarks = '';
    let segmentGuides = '';
    for(let i=1;i<pts.length;i++){
      const a=pts[i-1], b=pts[i];
      const dx=b.x-a.x, dy=b.y-a.y;
      const len=Math.max(1, Math.hypot(dx,dy));
      const nx=-dy/len, ny=dx/len;
      const mx=(a.x+b.x)/2, my=(a.y+b.y)/2;
      tickMarks += `<path d="M ${mx-nx*12} ${my-ny*12} L ${mx+nx*12} ${my+ny*12}" stroke="${gold}" stroke-width="2.5" ${cap} opacity=".52"/>`;
      segmentGuides += `<path d="M ${a.x+nx*8} ${a.y+ny*8} L ${b.x+nx*8} ${b.y+ny*8}" stroke="${purple}" stroke-width="1.7" ${cap} opacity=".28"/>`;
    }

    if(variant==='raw'){
      return holoStroke(rawPath, primary, 6.4, cap, 1)+
             `<path d="${rawPath}" fill="none" stroke="${bone}" stroke-width="1.8" ${cap} opacity=".22"/>`+
             (start ? `<circle cx="${start.x}" cy="${start.y}" r="11" fill="none" stroke="${primary}" stroke-width="3.5" opacity=".92"/>` : '')+
             (end ? `<circle cx="${end.x}" cy="${end.y}" r="6" fill="${primary}" opacity=".95"/>` : '');
    }

    if(variant==='rune'){
      let cutBars = '';
      let nodeRunes = '';
      pts.forEach((p,i)=>{
        const base = i===0 || i===pts.length-1 ? 15 : 11;
        nodeRunes += `<path d="M ${p.x-base} ${p.y} L ${p.x+base} ${p.y} M ${p.x} ${p.y-base} L ${p.x} ${p.y+base}" stroke="${gold}" stroke-width="2.8" ${cap} opacity="${i===0 || i===pts.length-1 ? .82 : .42}"/>`;
      });
      for(let i=1;i<pts.length;i++){
        const a=pts[i-1], b=pts[i];
        const dx=b.x-a.x, dy=b.y-a.y;
        const len=Math.max(1, Math.hypot(dx,dy));
        const nx=-dy/len, ny=dx/len;
        const mx=(a.x+b.x)/2, my=(a.y+b.y)/2;
        cutBars += `<path d="M ${mx-nx*18} ${my-ny*18} L ${mx+nx*18} ${my+ny*18}" stroke="${purple}" stroke-width="4.2" ${cap} opacity=".58"/>`;
      }
      return holoStroke(rawPath, primary, 7.1, cap, 1)+
             `<path d="${rawPath}" fill="none" stroke="${purple}" stroke-width="3.2" ${cap} opacity=".64" filter="url(#sigilPremiumGlow)"/>`+
             `<path d="${rawPath}" fill="none" stroke="${bone}" stroke-width="1.35" ${cap} opacity=".28"/>`+
             cutBars+
             nodeRunes+
             tickMarks+
             (start ? `<circle cx="${start.x}" cy="${start.y}" r="13" fill="none" stroke="${gold}" stroke-width="3.5" opacity=".9"/>` : '')+
             (end ? `<path d="M ${end.x-18} ${end.y-18} L ${end.x+18} ${end.y+18} M ${end.x+18} ${end.y-18} L ${end.x-18} ${end.y+18}" stroke="${gold}" stroke-width="3.2" ${cap} opacity=".82"/>` : '');
    }

    if(variant==='astral'){
      const star = `<path d="M 280 92 L 356 382 L 146 190 L 414 190 L 204 382 Z" fill="none" stroke="${gold}" stroke-width="2.3" ${cap} opacity=".46"/>`;
      const lattice = `<path d="M 280 118 L 280 442 M 202 202 L 358 358 M 358 202 L 202 358 M 196 280 L 364 280 M 230 356 L 330 356" fill="none" stroke="${purple}" stroke-width="2.4" ${cap} opacity=".38"/>`;
      const pulse = `<path d="M ${firstBend.x} ${firstBend.y} L 280 280 L ${lastBend.x} ${lastBend.y}" fill="none" stroke="${gold}" stroke-width="2.1" ${cap} opacity=".26"/>`;
      return halo+
             `<circle cx="280" cy="280" r="156" fill="none" stroke="${gold}" stroke-width="1.8" opacity=".24"/>`+
             star+
             lattice+
             holoStroke(rawPath, primary, 6.9, cap, 1)+
             `<path d="${rawPath}" fill="none" stroke="${purple}" stroke-width="2.45" ${cap} opacity=".38" filter="url(#sigilPremiumGlow)"/>`+
             `<path d="${rawPath}" fill="none" stroke="${bone}" stroke-width="1.55" ${cap} opacity=".32"/>`+
             pulse+
             segmentGuides+
             (start ? `<circle cx="${start.x}" cy="${start.y}" r="12" fill="${primary}" opacity=".92"/>` : '')+
             `<circle cx="${mid.x}" cy="${mid.y}" r="8" fill="${purple}" opacity=".9"/>`+
             (end ? `<circle cx="${end.x}" cy="${end.y}" r="10" fill="${gold}" opacity=".95"/>` : '')+
             `<circle cx="280" cy="280" r="44" fill="none" stroke="${bone}" stroke-width="2.2" opacity=".36"/>`;
    }

    // relic: ceremonial, premium. Default is now clean: no distracting red star behind it.
    let relicNodes = '';
    pts.forEach((p,i)=>{
      const r = i===0 || i===pts.length-1 ? 12 : 7;
      relicNodes += `<circle cx="${p.x}" cy="${p.y}" r="${r}" fill="none" stroke="${gold}" stroke-width="${i===0 || i===pts.length-1 ? 3.3 : 1.8}" opacity="${i===0 || i===pts.length-1 ? .82 : .38}"/>`;
    });
    const cleanRelicBase =
           `<circle cx="280" cy="280" r="190" fill="none" stroke="${gold}" stroke-width="2.1" opacity=".26"/>`+
           `<circle cx="280" cy="280" r="122" fill="none" stroke="${purple}" stroke-width="1.8" opacity=".18"/>`+
           `<circle cx="280" cy="280" r="58" fill="none" stroke="${bone}" stroke-width="1.6" opacity=".16"/>`;
    const ornateRelicGeometry =
           `<path d="M 280 92 L 356 382 L 146 190 L 414 190 L 204 382 Z" fill="none" stroke="${gold}" stroke-width="1.9" ${cap} opacity=".28"/>`+
           `<path d="M 180 300 C 230 185 330 185 380 300 C 326 255 234 255 180 300" fill="none" stroke="${purple}" stroke-width="2.2" ${cap} opacity=".28"/>`+
           `<path d="M 280 118 L 280 442 M 205 250 L 355 250 M 232 356 L 328 356 M 202 202 L 358 358 M 358 202 L 202 358" fill="none" stroke="${gold}" stroke-width="1.7" ${cap} opacity=".22"/>`;
    return cleanRelicBase+
           (relicDecor ? ornateRelicGeometry : '')+
           holoStroke(smoothPath, primary, 7.1, cap, 1)+
           `<path d="${smoothPath}" fill="none" stroke="${purple}" stroke-width="3.1" ${cap} opacity=".48" filter="url(#sigilPremiumGlow)"/>`+
           `<path d="${rawPath}" fill="none" stroke="${bone}" stroke-width="1.5" ${cap} opacity=".22"/>`+
           segmentGuides+
           tickMarks+
           relicNodes+
           (start ? `<path d="M ${start.x-16} ${start.y} L ${start.x+16} ${start.y} M ${start.x} ${start.y-16} L ${start.x} ${start.y+16}" stroke="${gold}" stroke-width="3.0" ${cap} opacity=".70"/>` : '')+
           (end ? `<path d="M ${end.x-20} ${end.y} L ${end.x+20} ${end.y}" stroke="${gold}" stroke-width="3.5" ${cap} opacity=".72"/>` : '')+
           `<path d="M 260 280 L 280 255 L 300 280 L 280 305 Z" fill="none" stroke="${bone}" stroke-width="2.1" opacity=".58"/>`;
  }

  function renderDormantWheel(){
    let svg = `<defs><radialGradient id="orbDormant" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="${sigilColor}" stop-opacity=".16"/><stop offset="100%" stop-color="#000" stop-opacity="0"/></radialGradient></defs>`;
    svg += `<circle cx="280" cy="280" r="245" fill="url(#orbDormant)" opacity=".95"/>`;
    svg += `<circle class="ring" cx="280" cy="280" r="202"/>`;
    for(let n=1;n<=9;n++){
      const p=pointForNumber(n); svg += `<line class="guide-line" x1="280" y1="280" x2="${p.x}" y2="${p.y}"/>`;
    }

    // Beginner animation: a sample path quietly forges itself before the user generates anything.
    const demoNums = [1,4,9,2,7,3,6];
    const demoPts = demoNums.map(pointForNumber);
    const demoPath = demoPts.map((p,i)=>(i?'L':'M')+p.x.toFixed(2)+' '+p.y.toFixed(2)).join(' ');
    svg += `<path class="demo-path" pathLength="1" d="${demoPath}" stroke="${sigilColor}" style="--sigil:${sigilColor}"/>`;
    demoPts.forEach((p,i)=>{ svg += `<circle class="demo-node" cx="${p.x}" cy="${p.y}" r="${i===0?7:5}" fill="${sigilColor}" style="transform-origin:${p.x}px ${p.y}px; animation-delay:${i*.13}s"/>`; });

    for(let n=1;n<=9;n++){
      const p=pointForNumber(n); svg += `<g><circle class="node-circle" cx="${p.x}" cy="${p.y}" r="25"/><text class="node-text" x="${p.x}" y="${p.y}">${n}</text></g>`;
    }
    dormantWheel.innerHTML = svg;
  }
  function renderAmbientSigils(){
    if(!ambientLayer) return;
    const lean = isLeanDevice();
    const colors = [sigilColor, lightenHex(sigilColor, .22), lightenHex(sigilColor, .42), '#e8ddd0', darkenHex(sigilColor, .18)];
    const templates = [
      `<path class="ambient-line" pathLength="1" d="M 0 -44 L 28 12 L -28 -6 L 16 42"/>`,
      `<path class="ambient-line" pathLength="1" d="M -38 -22 L 34 -22 L 0 36 L -22 4"/>`,
      `<path class="ambient-line" pathLength="1" d="M -36 0 L 0 -34 L 36 0 L 0 34 Z"/>`,
      `<path class="ambient-line" pathLength="1" d="M -34 -34 L 34 34 M 34 -34 L -34 34 M 0 -45 L 0 45"/>`,
      `<path class="ambient-line" pathLength="1" d="M -42 20 C -18 -36 18 -36 42 20 C 16 4 -16 4 -42 20"/>`,
      `<path class="ambient-line" pathLength="1" d="M 0 -42 L 0 42 M -28 -10 L 28 -10 M -18 18 L 18 18"/>`,
      `<circle class="ambient-ring" cx="0" cy="0" r="38"/><circle class="ambient-ring" cx="0" cy="0" r="18"/><path class="ambient-line" pathLength="1" d="M 0 -40 L 24 28 L -32 -10 L 32 -10 L -24 28 Z"/>`,
      `<circle class="ambient-ring" cx="0" cy="0" r="36"/><path class="ambient-line" pathLength="1" d="M -28 0 L 0 -28 L 28 0 L 0 28 M -18 -18 L 18 18"/>`
    ];

    // Fixed left/right pairs prevent the "everything is on one side" problem.
    // Tiny jitter keeps it alive without creating random clumps.
    const slots = [
      {left:9, top:17, size:72, side:'L'}, {left:86, top:17, size:72, side:'R'},
      {left:15, top:39, size:92, side:'L'}, {left:79, top:39, size:92, side:'R'},
      {left:8, top:67, size:76, side:'L'}, {left:88, top:67, size:76, side:'R'},
      {left:27, top:24, size:58, side:'L'}, {left:68, top:24, size:58, side:'R'},
      {left:29, top:72, size:64, side:'L'}, {left:69, top:72, size:64, side:'R'},
      {left:48, top:12, size:42, side:'C'}, {left:52, top:82, size:46, side:'C'}
    ];

    let html = '';
    const activeSlots = lean ? slots.filter((_,i)=> i < 6 || i === 10) : slots;
    activeSlots.forEach((slot,i)=>{
      const c = colors[i % colors.length];
      const jitterX = (Math.random()*4 - 2);
      const jitterY = (Math.random()*5 - 2.5);
      const left = Math.max(3, Math.min(92, slot.left + jitterX)).toFixed(2);
      const top = Math.max(7, Math.min(84, slot.top + jitterY)).toFixed(2);
      const size = slot.size + Math.round(Math.random()*10 - 5);
      const scale = (.74 + Math.random()*.30).toFixed(2);
      const op = (slot.side === 'C' ? .15 + Math.random()*.12 : .24 + Math.random()*.28).toFixed(2);
      const rot = (Math.random()*34 - 17).toFixed(1) + 'deg';
      const driftDir = slot.side === 'L' ? 1 : slot.side === 'R' ? -1 : (Math.random() > .5 ? 1 : -1);
      const driftX = (driftDir * (6 + Math.random()*10)).toFixed(1) + 'px';
      const floatDur = (4.2 + Math.random()*2.6).toFixed(2) + 's';
      const drawDur = (3.4 + Math.random()*2.2).toFixed(2) + 's';
      const spinDur = (10 + Math.random()*10).toFixed(2) + 's';
      const delay = (-Math.random()*3.2).toFixed(2) + 's';
      const template = templates[i % templates.length];
      html += `<div class="ambient-sigil balanced-${slot.side}" style="--c:${c};--size:${size}px;--left:${left}%;--top:${top}%;--scale:${scale};--op:${op};--rot:${rot};--driftX:${driftX};--floatDur:${floatDur};--drawDur:${drawDur};--spinDur:${spinDur};--delay:${delay};">
        <svg viewBox="-60 -60 120 120">${template}<circle class="ambient-dot" cx="0" cy="0" r="3"/></svg>
      </div>`;
    });

    const dustSlots = [];
    const dustPairs = lean ? 4 : 14;
    const centerDust = lean ? 1 : 8;
    for(let i=0;i<dustPairs;i++){
      dustSlots.push({left:6 + Math.random()*28, top:10 + Math.random()*78, side:'L'});
      dustSlots.push({left:66 + Math.random()*28, top:10 + Math.random()*78, side:'R'});
    }
    for(let i=0;i<centerDust;i++){
      dustSlots.push({left:40 + Math.random()*20, top:8 + Math.random()*84, side:'C'});
    }
    dustSlots.forEach((d,i)=>{
      const c = colors[i % colors.length];
      const driftDir = d.side === 'L' ? 1 : d.side === 'R' ? -1 : (Math.random()>.5?1:-1);
      const driftX = (driftDir * (5 + Math.random()*12)).toFixed(1) + 'px';
      const floatDur = (4.3 + Math.random()*4.2).toFixed(2) + 's';
      html += `<span class="glyph-dust" style="--c:${c};--left:${d.left.toFixed(2)}%;--top:${d.top.toFixed(2)}%;--driftX:${driftX};--floatDur:${floatDur};"></span>`;
    });
    ambientLayer.innerHTML = html;
  }


  setSigilToneVars(sigilColor);

  let generateLock = false;
  function igniteThenRun(){
    if(generateLock) return;
    generateLock = true;
    setTimeout(()=>{ generateLock = false; }, isLeanDevice() ? 420 : 1100);

    if(currentScreen !== 'input'){
      runRitual();
      return;
    }
    clearTimers();

    if(isLeanDevice()){
      if(dormantChamber){
        dormantChamber.classList.remove('igniting');
      }
      requestAnimationFrame(()=>{
        runRitual();
        setTimeout(renderAmbientSigils, 80);
      });
      return;
    }

    if(dormantChamber){
      dormantChamber.classList.remove('igniting');
      void dormantChamber.offsetWidth;
      dormantChamber.classList.add('igniting');
    }
    setTimeout(()=>{
      if(dormantChamber) dormantChamber.classList.remove('igniting');
      runRitual();
      setTimeout(renderAmbientSigils, 150);
    }, 900);
  }

  function renderWheel(activeIndex=-1, draw=false, finalMode=false, showRawPath=false, progress=null){
    const nums = state.nums || [];
    const path = buildPath(nums);
    const guideHidden = hideGuidesToggle.checked;
    const pts = nums.map(pointForNumber);
    const partial = (draw && typeof progress === 'number') ? buildPartialPath(nums, progress) : null;
    let svg = `<defs><radialGradient id="orb" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="${sigilColor}" stop-opacity=".22"/><stop offset="100%" stop-color="#000" stop-opacity="0"/></radialGradient>${sigilPremiumDefs()}</defs>`;
    if(previewMode === 'poster'){
      svg += `<rect width="560" height="560" fill="#efe0c5"/>`;
    } else if(!transparentPreview) {
      svg += `<circle cx="280" cy="280" r="245" fill="url(#orb)" opacity=".8"/>`;
    }
    if(!guideHidden && previewMode!=='poster'){
      svg += `<circle class="ring" cx="280" cy="280" r="202"/>`;
      for(let n=1;n<=9;n++){ const p=pointForNumber(n); svg += `<line class="guide-line" x1="280" y1="280" x2="${p.x}" y2="${p.y}"/>`; }
    }

    if(finalMode){
      svg += `<g>${buildSigilMarkup(currentVariant)}</g>`;
    } else if(draw && partial && partial.d){
      svg += holoStroke(partial.d, sigilColor, 7.2, 'stroke-linecap="round" stroke-linejoin="round"', 1);
      for(let i=0;i<=partial.completedIndex;i++){
        if(pts[i]) svg += `<circle cx="${pts[i].x}" cy="${pts[i].y}" r="6.5" fill="${sigilColor}" opacity=".92"/>`;
      }
      const active = pts[partial.activeIndex];
      if(active){
        svg += `<circle cx="${active.x}" cy="${active.y}" r="12" fill="none" stroke="${sigilColor}" stroke-width="3.5" opacity=".95"/>`;
        svg += `<circle cx="${active.x}" cy="${active.y}" r="5.2" fill="${sigilColor}" opacity=".95"/>`;
      }
    } else if(path && !finalMode && showRawPath){
      svg += holoStroke(path, sigilColor, 7.2, 'stroke-linecap="round" stroke-linejoin="round"', 1);
      pts.forEach((p,i)=>{ svg += `<circle cx="${p.x}" cy="${p.y}" r="6" fill="${sigilColor}" opacity="${activeIndex>=0 && i<=activeIndex ? .95 : .52}"/>`; });
    }

    if(previewMode !== 'poster'){
      for(let n=1;n<=9;n++){
        const p=pointForNumber(n);
        let active = false;
        if(draw && partial){
          active = nums[partial.activeIndex]===n;
        } else if(activeIndex>=0){
          active = nums[activeIndex]===n;
        }
        svg += `<g><circle class="node-circle ${active?'active-node':''}" cx="${p.x}" cy="${p.y}" r="25"/><text class="node-text" x="${p.x}" y="${p.y}">${n}</text></g>`;
      }
    }
    wheelSvg.innerHTML = svg;
  }

  function animateSvgPath(el, duration=1400){
    if(!el || !el.getTotalLength) return;
    const len = el.getTotalLength();
    el.style.transition = 'none';
    el.style.strokeDasharray = len;
    el.style.strokeDashoffset = len;
    el.getBoundingClientRect();
    requestAnimationFrame(()=>{
      el.style.transition = `stroke-dashoffset ${duration}ms cubic-bezier(.2,.85,.15,1)`;
      el.style.strokeDashoffset = '0';
    });
  }
  function renderOriginalAnimated(){
    originalText.innerHTML = state.clean ? [...state.clean].map(c=>`<span class="letter">${c}</span>`).join('') : '—';
  }
  function renderVowelAnimated(final=false){
    const vowels = yVowelToggle.checked ? 'AEIOUY' : 'AEIOU';
    const chars = [...(state.clean||'')].map(c=>{
      const vanish = vowels.includes(c) ? (final ? ' vanish' : '') : '';
      return vowels.includes(c) ? `<span class="letter${vanish}">${c}</span>` : `<span class="letter">${c}</span>`;
    }).join('');
    vowelText.innerHTML = chars || '—';
    if(final){ timers.push(setTimeout(()=>{ vowelText.textContent = state.noVowels || '—'; }, 520)); }
  }
  function renderDuplicateAnimated(final=false){
    const seen = new Set(); let html='';
    for(const c of (state.noVowels||'')){
      const duplicate = seen.has(c); if(!duplicate) seen.add(c);
      html += `<span class="letter${duplicate && final ? ' duplicate' : ''}">${c}</span>`;
    }
    duplicateText.innerHTML = html || '—';
    if(final){ timers.push(setTimeout(()=>{ duplicateText.textContent = state.reduced || '—'; }, 520)); }
  }
  function pathDescription(){
    if(!state.letters.length) return '—';
    return state.letters.map((l,i)=>`${l}=${state.nums[i]}`).join(' • ') + `  |  ${state.nums.join(' → ')}`;
  }
  function finalSvgString(variant=currentVariant, opts={transparent:false, forExport:false}){
    const bg = opts.transparent ? '' : (previewMode==='poster'
      ? `<rect width="560" height="560" fill="#efe0c5"/>`
      : `<rect width="560" height="560" fill="#050000"/><circle cx="280" cy="280" r="245" fill="#160202"/><circle cx="280" cy="280" r="202" fill="none" stroke="rgba(255,79,216,.22)" stroke-width="2"/>`);
    const glow = opts.forExport && opts.transparent ? `<defs>${sigilPremiumDefs()}</defs>` : `<defs>${sigilPremiumDefs()}<filter id="fg"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>`;
    const filter = opts.forExport && opts.transparent ? '' : 'filter="url(#fg)"';
    const posterHead = previewMode==='poster' && !opts.transparent ? `<text x="280" y="55" text-anchor="middle" font-family="Georgia, serif" font-size="28" letter-spacing="3" fill="#34180a">SIGIL STUDIO</text>` : '';
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 560">${glow}${bg}${posterHead}<g ${filter}>${buildSigilMarkup(variant)}</g></svg>`;
  }
  function renderPreviewMode(){
    previewFrame.className = 'preview-frame mode-' + previewMode + ' variant-' + currentVariant + (transparentPreview ? ' transparent-on' : '');
    previewFrame.innerHTML = '';
    if(previewMode==='shirt'){
      const shirt = document.createElement('div'); shirt.className='shirt-shape' + (transparentPreview ? ' transparent-on' : ''); previewFrame.appendChild(shirt);
    }
    if(previewMode==='poster'){
      const head = document.createElement('div'); head.className='poster-head'; head.textContent='Sigil Studio'; previewFrame.appendChild(head);
