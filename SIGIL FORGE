.preview-frame.completion-burst::before{
  content:"";
  position:absolute;
  z-index:7;
  left:50%;
  top:50%;
  width:34%;
  aspect-ratio:1/1;
  border-radius:999px;
  border:2px solid rgba(255,214,132,.94);
  transform:translate(-50%,-50%) scale(.36);
  opacity:0;
  pointer-events:none;
  box-shadow:
    0 0 18px rgba(255,214,132,.92),
    0 0 38px rgba(209,10,10,.72),
    0 0 72px rgba(255,107,223,.34),
    inset 0 0 22px rgba(255,214,132,.58);
  animation:sigilCompletionRing .82s cubic-bezier(.12,.86,.14,1) forwards;
}
.preview-frame.completion-burst::after{
  content:"";
  position:absolute;
  z-index:6;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 50% 50%, rgba(255,245,210,.88) 0 1.5%, transparent 4%),
    radial-gradient(circle at 45% 44%, rgba(255,99,52,.78) 0 .9%, transparent 2.6%),
    radial-gradient(circle at 55% 43%, rgba(255,132,232,.58) 0 .85%, transparent 2.5%),
    radial-gradient(circle at 58% 57%, rgba(255,174,76,.76) 0 .8%, transparent 2.4%),
    radial-gradient(circle at 42% 59%, rgba(255,78,78,.72) 0 .85%, transparent 2.5%),
    radial-gradient(circle at 50% 50%, rgba(255,214,132,.34), transparent 28%),
    radial-gradient(circle at 50% 50%, rgba(209,10,10,.28), transparent 44%);
  opacity:0;
  transform:scale(.68);
  filter:blur(.15px);
  mix-blend-mode:screen;
  animation:sigilCompletionFlash .9s cubic-bezier(.12,.86,.14,1) forwards;
}
@keyframes sigilCompletionRing{
  0%{opacity:0; transform:translate(-50%,-50%) scale(.28)}
  18%{opacity:1}
  72%{opacity:.62}
  100%{opacity:0; transform:translate(-50%,-50%) scale(2.05)}
}
@keyframes sigilCompletionFlash{
  0%{opacity:0; transform:scale(.58); filter:brightness(1.2)}
  16%{opacity:1; transform:scale(.82); filter:brightness(2.2)}
  52%{opacity:.82; transform:scale(1.08); filter:brightness(1.6)}
  100%{opacity:0; transform:scale(1.42); filter:brightness(1)}
}
.preview-frame.completion-burst .preview-svg{
  animation:sigilCompleteGlow .78s cubic-bezier(.12,.86,.14,1) forwards;
}
@keyframes sigilCompleteGlow{
  0%{filter:brightness(1)}
  22%{filter:brightness(1.85) saturate(1.25) drop-shadow(0 0 22px rgba(209,10,10,.7))}
  100%{filter:brightness(1) saturate(1)}
}
.ambient-sigil{
  will-change:transform, opacity;
}
.glyph-dust{
  will-change:transform, opacity;
}
@media (prefers-reduced-motion: reduce){
  .ambient-sigil,
  .ambient-line,
  .ambient-ring,
  .ambient-dot,
  .glyph-dust,
  .home-draw,
  .home-node,
  .home-orbit,
  .demo-path,
  .demo-node{
    animation-duration:.001ms!important;
    animation-iteration-count:1!important;
  }
  .preview-frame.completion-burst::before,
  .preview-frame.completion-burst::after{
    animation:none!important;
    opacity:0!important;
  }
}




