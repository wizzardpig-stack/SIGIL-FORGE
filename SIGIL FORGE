    const items = loadGallery();
    gallery.innerHTML = items.length ? items.map(item=>`<button class="gallery-card" data-id="${item.id}"><div class="gallery-thumb">${item.svg}</div><div class="gallery-caption">${item.label}</div></button>`).join('') : `<div class="transparent-note">No saved sigils yet.</div>`;
