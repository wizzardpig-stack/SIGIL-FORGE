  $('exportPackBtn').addEventListener('click', ()=>{ if(currentScreen!=='chamber' || !state.nums.length) runRitual(); setTimeout(exportPack, (currentScreen!=='chamber'||setStageCurrent!=='final') ? forgeDurationMs() : 0); });

  // V24: Background intensity — 0 nearly black, 30 subtle, 70 clearly visible, 100 full strength.
  // Drives a single CSS variable; Black mode is untouched because the CSS only targets Stars/Nebula.
  const bgIntensitySlider = $('bgIntensity');
  function applyBgIntensity(v){
    const val = clamp(Number(v)||0, 0, 100);
    const dim = (1 - val/100) * 0.97;
    if(forgeStage) forgeStage.style.setProperty('--bgDim', dim.toFixed(3));
    const label = $('bgIntensityValue');
    if(label) label.textContent = Math.round(val);
  }
  if(bgIntensitySlider){
    bgIntensitySlider.addEventListener('input', ()=>applyBgIntensity(bgIntensitySlider.value));
    applyBgIntensity(bgIntensitySlider.value);
  }

  applyBackdropMode(stageBackground);
  setRelicDecor(relicDecor);

  renderAlphabet(compactAlphabet,[]);
  renderAlphabet(alphabetGrid,[]);
  initSwatches();
  setVariant(currentVariant);
  renderPreviewMode();
  renderDormantWheel();
  renderAmbientSigils();
  renderGallery();
  setScreen('input');
  updateSummary();
  const tBtn = $('transparentPreviewBtn'); if(tBtn) tBtn.classList.toggle('active', transparentPreview);
})();
</script>
</body>
</html>
